# ---- Transport ----
# stdio (local, launched by the client) or streamable-http (remote, production)
TRANSPORT=streamable-http
HOST=0.0.0.0
PORT=8000
MCP_PATH=/mcp
# Stateless core (2026-07-28 spec): every request self-contained, scales on serverless
STATELESS_HTTP=true

# ---- Auth ----
# one of: none | bearer | oauth2
#   none   -> public endpoint (local dev)
#   bearer -> static API key; send: Authorization: Bearer <API_KEY>
#   oauth2 -> full OAuth 2.1 authorization + resource server (recommended)
AUTH_MODE=none
API_KEY=change-me-to-a-long-random-secret

# ---- OAuth 2.1 (used when AUTH_MODE=oauth2) ----
# Public base URL clients reach this server on; drives the issuer + token audience.
# Leave empty to derive from HOST/PORT (e.g. http://localhost:8000). Set for real deploys.
PUBLIC_BASE_URL=
# Access-token lifetime (s) and refresh-token lifetime (s; 0 disables expiry)
OAUTH_TOKEN_TTL=3600
OAUTH_REFRESH_TTL=2592000
# Demo login bootstrapped into the SQLite user store at startup. CHANGE THESE.
OAUTH_DEMO_USER=admin
OAUTH_DEMO_PASSWORD=admin

# ---- LLM provider ----
# one of: groq | ollama | openai | anthropic | fake
LLM_PROVIDER=groq
LLM_MODEL=
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
OPENAI_BASE_URL=https://api.openai.com/v1
OLLAMA_BASE_URL=http://localhost:11434

# ---- Embeddings ----
# one of: ollama | openai | hashing  (hashing = free, offline, deterministic)
EMBED_PROVIDER=hashing
EMBED_MODEL=
# For ollama embeddings: EMBED_MODEL=nomic-embed-text

# ---- Web search ----
# one of: duckduckgo | none  (duckduckgo = free, no API key; none = offline)
WEB_SEARCH_PROVIDER=duckduckgo

# ---- RAG ----
DATA_DIR=data/index
CHUNK_SIZE=900
CHUNK_OVERLAP=150
DEFAULT_TOP_K=4
REQUEST_TIMEOUT=60

# ---- Vector store ----
# one of: memory | pgvector  (memory = in-process numpy + disk; pgvector = Postgres)
# pgvector also needs the optional extra: pip install "mcp-tool-suite[pgvector]"
VECTOR_STORE=memory
# Postgres DSN used when VECTOR_STORE=pgvector, e.g. postgresql://mcp:mcp@localhost:5432/mcp
PGVECTOR_DSN=
PGVECTOR_TABLE=mcp_vectors
